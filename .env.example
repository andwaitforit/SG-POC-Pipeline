# Copy to .env and fill in. .env is gitignored.
# mabl permissions API keys per use case, so the pipeline needs two.
# Create both at Settings > APIs > API keys.

# Editor key - reads the seed table, writes the DataTables (stages 01-04)
MABL_API_KEY=

# Deployment Trigger (or CI/CD Integration) key - fires plans and reads
# results (stage 05). An Editor key is NOT permissioned for these endpoints.
# Optional: omit it and stages 01-04 still work.
MABL_DEPLOY_KEY=
